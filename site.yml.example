# site.yml — the only file you edit to make this site yours.
# Copy this file to `site.yml` (same folder, same contents) and fill in your
# details. Every page is rendered from this single file plus the Markdown in
# `content/`.
#
#   cp site.yml.example site.yml
#
# All profile fields below `links:` are OPTIONAL. Omit any array/field and the
# home page simply doesn't render that section — so you can start from an
# empty profile and add blocks incrementally.

name: "Alexander Jerry"
label: "Azure Cloud,  Azure Devops, Azure Platform Engineer, Azure Infrastructure Engineer"                        # hero subtitle
role: "Azure Devops"                                  # shown under your name
location: "Remote"                              # omit the line to hide location
email: alexpriestj@yahoo.com                                        # set an address to surface it; null hides it
base_url: "https://alexjerry.github.io/my-markdown/" # canonical origin (used in SEO/schema)

links:                                             # anything you leave blank is hidden
  github: "https://github.com/alexjerry"
  linkedin: "https://www.linkedin.com/in/alexander-jerry/"
  

resume:
  path: "/resume.pdf"                              # served from public/resume.pdf — replace with your own PDF
  download_name: "Your-Name-Resume.pdf"

brand: "•"                                         # nav mark (any emoji or short text)
theme:
  default: "auto"                                  # "light" | "dark" | "auto"

# Optional profile blocks (home page) ----------------------------------------
# Remove or leave empty any block you don't want — the template just skips it.

focus:                                             # chip row under the hero
  - AI Agents
  - MLOps
  - Databricks
  - DevOps & Platform Engineering
  - Azure & Cloud Infrastructure
  - Infrastructure as Code
  - AI Infrastructure
  - Developer Tooling
  - Observability
  - Zero Trust & Secure Platforms
  - Automation at Scale

tech:                                              # tech badges (built from simple-icons slugs)
  - { name: Azure,          slug: microsoftazure }
  - { name: Azure DevOps,   slug: azuredevops }
  - { name: Terraform,      slug: terraform }
  - { name: Kubernetes,      slug: kubernetes }
  - { name: Docker,          slug: docker }
  - { name: Linux,           slug: linux }
  - { name: PowerShell,      slug: powershell }
  - { name: Bash,            slug: bash }
  - { name: Grafana,         slug: grafana }
  - { name: GitHub Actions,  slug: githubactions }

principles:                                        # short craft beliefs
  - Automate repetitive work
  - Pipeline matter
  - Understand before optimizing
  - Security should be built in
  - Learn by building
  - Ship early, improve continuously
  

time_on:                                           # {label, level: 0–10} — what you spend time on
  - { label: "Platform Engineering",  level: 10 }
  - { label: "Cloud Infrastructure",  level: 10 }
  - { label: "Automation",            level: 10 }
  - { label: "Terraform",              level: 9  }
  - { label: "AI Infrastructure",      level: 9  }
  - { label: "Python",                 level: 9  }
  - { label: "Kubernetes",             level: 8  }
  - { label: "Observability",          level: 8  }
exploring:                                         # {label, level: 0–10} — what you're exploring
  - { label: "AI Agents",          level: 9 }
  - { label: "Data engineering",      level: 9 }
  - { label: "Local Tools",         level: 9 }
  - { label: "IBM Mainframes", level: 9 }
  - { label: "MLOps",             level: 8 }

currently_building:                                # free-text list
  - { label: "Azure functions",          level: 9 }
  - { label: "Data engineering",      level: 9 }
shaped_thinking:                                   # books / lines that shaped your approach
  - A book or line you'd recommend

# Which sections appear in the nav, in order. Delete a line to hide that
# section. Change the label to rename it (e.g. Blog → Writing).
sections:
  - { kind: projects,  label: "Projects" }
  - { kind: tutorials, label: "Tutorials" }
  - { kind: blog,      label: "Blog" }
  - { kind: about,     label: "About" }
